{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute capacity private-book record",
  "description": "Minimum record requirements before a supplier quote or buyer mandate may be included in matching or underwriting.",
  "type": "object",
  "required": ["record_type", "sku", "gpu_count", "region", "term_months", "confidence", "source_classification"],
  "properties": {
    "record_type": { "enum": ["supplier_quote", "buyer_mandate", "executed_deal"] },
    "sku": { "type": "string" },
    "gpu_count": { "type": "integer", "minimum": 1 },
    "region": { "type": "string" },
    "cluster_topology": { "type": "string" },
    "network_gbps": { "type": "number", "minimum": 0 },
    "sla_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "available_from": { "type": "string", "format": "date" },
    "term_months": { "type": "integer", "minimum": 1 },
    "usd_hr": { "type": "number", "minimum": 0 },
    "cancellation_rights": { "type": "string" },
    "credit_grade": { "type": "string" },
    "confidence": { "enum": ["verified", "permissioned", "simulated", "unverified"] },
    "source_classification": { "enum": ["public", "permissioned_private", "synthetic"] },
    "source_reference": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "record_type": { "const": "supplier_quote" } } },
      "then": { "required": ["cluster_topology", "network_gbps", "sla_percent", "available_from", "usd_hr"] }
    },
    {
      "if": { "properties": { "record_type": { "const": "buyer_mandate" } } },
      "then": { "required": ["available_from", "credit_grade"] }
    }
  ]
}
